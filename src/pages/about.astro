---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const timeline = [
  {
    year: 'Feb 2026-Present',
    title: 'Technical Co-Founder',
    company: 'qpIQ (proptech), Melbourne',
    description: 'Solo-built a B2B SaaS product for Australian real-estate agents, from the three-layer authorisation chain that isolates each tenant on a deny-all datastore to a nine-loop autonomous delivery system running spec-first against 28 capability specifications. Ran the field pilot inside a real agent\'s Saturday open home, and published the postmortem when the first live trial captured nobody.'
  },
  {
    year: 'Feb 2026-Present',
    title: 'Technical Co-Founder',
    company: 'storipro (proptech), remote',
    description: 'Joined as a contract engineer and came on as technical co-founder after shipping the platform\'s production systems. That covered the Stripe billing integration, a hardened Firestore security model proven with an emulator test suite, an autonomous issue-to-PR pipeline, and the data pipelines that feed the platform.'
  },
  {
    year: '2022-Present',
    title: 'Senior Instructional Designer',
    company: 'commercetools, remote in Italy and Australia',
    description: 'Instructional Designer from 2022; promoted to Senior in January 2026. Architected an orchestrator-agent AI authoring system with an eval harness, built agentic content-drift detection running in CI, and drove a single-source-of-truth documentation program across the platform. Did all of it while designing the learning systems that serve thousands of global developers. Led the team\'s adoption of the agentic toolchain.'
  },
  {
    year: '2022',
    title: 'Graduate Certificate in Educational Design',
    company: 'Monash University, Australia',
    description: 'Formal training in instructional design principles, learning theory, and evidence-based assessment strategies.'
  },
  {
    year: '2019-2022',
    title: 'Co-Founder & Learning Designer',
    company: '3 Steps Away, Australia',
    description: 'Built social justice education enterprise from concept to market delivery. Led end-to-end learning strategy, product development, and commercialization of blended learning experiences.'
  },
  {
    year: '2019-2021',
    title: 'Humanities Learning Area Leader & House Leader',
    company: 'Emmaus College, Australia',
    description: 'Managed team of 30+ educators overseeing 15 subject programs. Led strategic learning operations and provided senior leadership for cohort of 150 students.'
  },
  {
    year: '2014-2018',
    title: 'Online Interfaith Dialogue Facilitator',
    company: 'Generation Global, remote international',
    description: 'Facilitated 200+ international video dialogues. Designed dialogue experiences across complex cultural contexts while managing stakeholder relationships with ministers, NGO founders, and thought leaders.'
  },
  {
    year: '2011-2018',
    title: 'Social Justice Coordinator & Teacher',
    company: 'St Monica\'s College, Australia',
    description: 'Coordinated extracurricular program for 150+ students. Designed experiential learning units and implemented state curriculum across multiple year levels and disciplines.'
  },
  {
    year: '2007',
    title: 'Master of Arts (Arts and Sciences)',
    company: 'Universiteit Maastricht, the Netherlands',
    description: 'Focus on anthropology, international development policy, and contemporary world history.'
  },
  {
    year: '2003-2006',
    title: 'Bachelor of Arts (Humanities and Social Sciences)',
    company: 'Universiteit Maastricht, the Netherlands',
    description: 'Focus on history, philosophy, international politics and sociology.'
  }
];

// Kept off the main work grid: the learning-systems case studies that sit behind the
// current positioning rather than in front of it. Pages stay live at these URLs.
const earlierWork = [
  {
    title: 'Alex Chen: synthetic eval persona',
    href: '/projects/alex-chen-learner-persona',
    note: 'A synthetic senior developer that reviews documentation and catches gaps before real developers hit them.'
  },
  {
    title: 'B2B Commerce learning path',
    href: '/projects/b2b-learning-path',
    note: 'Owned end to end, every API example checked against the RAML source; passed an automated critique gate at 88/100.'
  },
  {
    title: 'Modular learning path ecosystem',
    href: '/projects/modular-learning-paths',
    note: 'One content structure behind 9 paths, 30+ modules and 200+ pages of technical material.'
  },
  {
    title: 'Developer Essentials learning path',
    href: '/projects/developer-essentials-learning-path',
    note: 'A 20-hour, API-first course taking enterprise developers to production-ready.'
  },
  {
    title: '3 Steps Away',
    href: '/projects/3-steps-away',
    note: 'Co-founded an education company and took it from concept to market. Where the systems thinking started.'
  }
];
---

<Layout title="About - Luke Panaccio">
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-bg-primary">
      <!-- Atmospheric background effects -->
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-accent-primary/10 rounded-full blur-[120px] animate-glow"></div>
        <div class="absolute bottom-0 left-1/3 w-[400px] h-[400px] bg-accent-secondary/8 rounded-full blur-[100px]" style="animation: glow 10s ease-in-out infinite; animation-delay: 2s;"></div>
      </div>
      
      <div class="relative max-w-4xl mx-auto px-6 py-24 md:py-32">
        <div class="stagger-children">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold text-text-primary mb-12 leading-[1.1]">
            About me
          </h1>
          <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
            <div class="flex-shrink-0">
              <img 
                src="/images/luke-bnw-headshot.webp" 
                alt="Luke Panaccio" 
                class="w-40 h-40 md:w-48 md:h-48 rounded-full object-cover border-4 border-accent-primary/20 shadow-xl"
              />
            </div>
            <div class="flex-1 text-center md:text-left">
              <p class="text-xl md:text-2xl text-text-secondary leading-relaxed">
                I build production AI systems: agentic delivery pipelines, payment integrity, hardened data layers. Then I make them usable for the people and the models downstream; a decade in education before this is the edge behind that second half.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Main Content -->
    <section class="py-20 md:py-24 bg-bg-secondary">
      <div class="max-w-4xl mx-auto px-6">
        <div class="space-y-12">
          <div class="space-y-6">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary">My journey</h2>
            
            <div class="space-y-6 text-lg text-text-secondary leading-relaxed">
              <p>
                Today I build production AI and software systems. As a technical co-founder at <a href="https://storipro.ai" target="_blank" rel="noopener" class="text-accent-primary font-semibold hover:underline">storipro</a>, I shipped the platform's Stripe billing integration, worked out how its data could be attacked and locked it down, and built an autonomous issue-to-PR pipeline. At <a href="https://commercetools.com" target="_blank" rel="noopener" class="text-accent-primary font-semibold hover:underline">commercetools</a>, I architected an orchestrator-agent AI authoring system with its own eval harness and drove a single-source-of-truth documentation program across the platform.
              </p>

              <p>
                I got here from an unusual direction: a decade in education first, ending as a humanities department lead over 30+ educators, with a co-founded education company (<span class="text-accent-primary font-semibold">3 Steps Away</span>) that taught me to take a system from concept to market.
              </p>

              <p>
                Building something well and explaining it clearly don't always come from the same person, and that's the compounding part. I design for the humans and agents that use the output: clear interfaces, honest failure modes, docs that double as a contract. The engineering I formalized by shipping.
              </p>
            </div>
          </div>
          
          <div class="space-y-6">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary">What I do</h2>
            
            <p class="text-lg text-text-secondary leading-relaxed">
              I work at the intersection of building and communicating. I architect and ship applied-AI systems, then make them clear to the people and models that use them. Here's where that splits.
            </p>

            <div class="grid md:grid-cols-2 gap-6 mt-8">
              <div class="bg-bg-elevated border border-border-subtle rounded-xl p-6 hover:border-accent-primary/30 transition-all duration-300 hover:-translate-y-1">
                <h3 class="font-bold text-accent-primary mb-3 text-base uppercase tracking-wider">AI Systems &amp; Agents</h3>
                <p class="text-text-secondary text-base leading-relaxed">
                  I design and ship agentic systems: orchestrator-agent architectures, autonomous delivery pipelines, eval harnesses. On retrieval I work the corpus side and the trade-off (three separate builds where I weighed embedding retrieval against a cheaper, inspectable alternative, and documented which one won and why).
                </p>
              </div>
              <div class="bg-bg-elevated border border-border-subtle rounded-xl p-6 hover:border-accent-primary/30 transition-all duration-300 hover:-translate-y-1">
                <h3 class="font-bold text-accent-primary mb-3 text-base uppercase tracking-wider">Agentic Engineering (Claude Code)</h3>
                <p class="text-text-secondary text-base leading-relaxed">
                  I operate the full agentic toolchain: subagents, dynamic workflows, eval harnesses, MCP servers, headless Claude Code in CI, worktrees, CLAUDE.md schemas. I run the stack, I don't just call the API.
                </p>
              </div>
              <div class="bg-bg-elevated border border-border-subtle rounded-xl p-6 hover:border-accent-primary/30 transition-all duration-300 hover:-translate-y-1">
                <h3 class="font-bold text-accent-primary mb-3 text-base uppercase tracking-wider">Production Software Engineering</h3>
                <p class="text-text-secondary text-base leading-relaxed">
                  I ship hardened production code. A full Stripe billing integration with idempotency and self-healing reconciliation, a threat-modelled Firestore security layer proven with an emulator test suite, and distributed-systems hygiene throughout.
                </p>
              </div>
              <div class="bg-bg-elevated border border-border-subtle rounded-xl p-6 hover:border-accent-primary/30 transition-all duration-300 hover:-translate-y-1">
                <h3 class="font-bold text-accent-primary mb-3 text-base uppercase tracking-wider">Knowledge &amp; Content Systems</h3>
                <p class="text-text-secondary text-base leading-relaxed">
                  Information architecture, single-source-of-truth design, and retrieval corpora that RAG can actually work against. I ran a 5-person programme that cut the duplicate docs competing with each other in search and in a production RAG assistant.
                </p>
              </div>
            </div>
          </div>
          
          <div class="space-y-6">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary">My philosophy</h2>
            
            <div class="space-y-6 text-lg text-text-secondary leading-relaxed">
              <p>
                I build for <strong>judgment, not output</strong>. Anyone can wire up an API call. The value is in the decisions: what to build, what to reject, and how you'll know it worked. Every system I ship leads with the architecture call and the trade-off behind it, backed by evals, quality gates, and honest failure handling.
              </p>

              <p>
                I treat <strong>documentation as data and interfaces as contracts</strong>. The hardest part of an AI system isn't the model. It's making the behaviour clear and the output trustworthy to the humans and agents downstream. That's where the teaching years compound: build for whoever has to use the output, human or model.
              </p>

              <p>
                And I <strong>validate before I claim</strong>. A number I can defend in an interview beats a demo every time. The receipts carry the work.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Timeline -->
    <section class="py-20 md:py-24 bg-bg-primary">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-12">Professional timeline</h2>
        
        <div class="space-y-8">
          {timeline.map((item, index) => (
            <div class="flex gap-6 animate-fade-in" style={`animation-delay: ${index * 0.1}s; opacity: 0;`}>
              <div class="flex-shrink-0 w-24 text-right">
                <span class="text-sm font-bold text-accent-primary">{item.year}</span>
              </div>
              <div class="flex-shrink-0">
                <div class="w-3 h-3 bg-accent-primary rounded-full mt-1.5 shadow-lg shadow-accent-primary/50"></div>
                <div class="w-0.5 h-full bg-border-medium mx-auto mt-1"></div>
              </div>
              <div class="flex-grow pb-8">
                <h3 class="font-bold text-text-primary mb-1 text-xl">{item.title}</h3>
                <p class="text-sm text-accent-secondary font-medium mb-2">{item.company}</p>
                <p class="text-text-secondary leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-20 pt-12 border-t border-border-subtle">
          <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-4">Earlier work</h2>
          <p class="text-lg text-text-secondary leading-relaxed mb-8 max-w-3xl">
            The learning-systems case studies. They sit behind the current work rather than in front of it, but the write-ups are still here.
          </p>

          <ul class="space-y-4">
            {earlierWork.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group block rounded-xl border border-border-subtle bg-bg-elevated p-5 hover:border-accent-primary/40 transition-all duration-300"
                >
                  <span class="flex items-center font-bold text-text-primary group-hover:text-accent-primary transition-colors">
                    {item.title}
                    <svg class="w-4 h-4 ml-2 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </span>
                  <span class="mt-1 block text-text-secondary text-base leading-relaxed">{item.note}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
    
    <!-- CTA -->
    <section class="relative py-20 md:py-24 bg-bg-secondary overflow-hidden">
      <!-- Background decoration -->
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-accent-primary/10 rounded-full blur-[120px]"></div>
      </div>
      
      <div class="relative max-w-4xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-6">Let's work together</h2>
        <p class="text-lg text-text-secondary mb-12 max-w-2xl leading-relaxed">
          I'm open to applied-AI, Solutions Architect, and Forward-Deployed Engineer roles, anywhere the job is to architect production AI systems and make them usable. If that's what you're building, I'd love to connect.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={`${base}#contact`}
            class="group inline-flex items-center justify-center px-8 py-4 bg-gradient-accent text-bg-primary rounded-lg font-bold hover:shadow-xl hover:shadow-accent-primary/30 transition-all duration-300 hover:-translate-y-1"
          >
            Get in touch
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href={`${base}#work`}
            class="inline-flex items-center justify-center px-8 py-4 border border-border-medium rounded-lg font-bold text-text-primary hover:border-accent-primary hover:bg-bg-elevated transition-all duration-300"
          >
          View my work
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  /* Custom utilities using CSS variables */
  .bg-bg-primary {
    background-color: var(--color-bg-primary);
  }
  
  .bg-bg-secondary {
    background-color: var(--color-bg-secondary);
  }
  
  .bg-bg-elevated {
    background-color: var(--color-bg-elevated);
  }
  
  .bg-gradient-accent {
    background: var(--gradient-accent);
  }
  
  .text-text-primary {
    color: var(--color-text-primary);
  }
  
  .text-text-secondary {
    color: var(--color-text-secondary);
  }
  
  .text-accent-primary {
    color: var(--color-accent-primary);
  }
  
  .text-accent-secondary {
    color: var(--color-accent-secondary);
  }
  
  .text-bg-primary {
    color: var(--color-bg-primary);
  }
  
  .border-border-subtle {
    border-color: var(--color-border-subtle);
  }
  
  .border-border-medium {
    border-color: var(--color-border-medium);
  }
  
  .border-accent-primary {
    border-color: var(--color-accent-primary);
  }
  
  /* Animation for glow effect */
  @keyframes glow {
    0%, 100% {
      opacity: 0.1;
    }
    50% {
      opacity: 0.2;
    }
  }
  
  .animate-glow {
    animation: glow 8s ease-in-out infinite;
  }
</style>